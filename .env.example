# Модель Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
# cpu -> int8, cuda -> int8_float16 / float16
WHISPER_COMPUTE_TYPE=int8
# Пусто = автоопределение языка
WHISPER_LANGUAGE=ru

# Длина куска распознавания, секунды: пик памяти линеен по длине куска
ASR_CHUNK_SEC=1200

# Нарезка на смысловые блоки, секунды
BLOCK_SEC=90
MIN_BLOCK_SEC=25
PAUSE_SEC=1.5

# 0 = по числу ядер; beam 1 экономит память и время ценой качества
CPU_THREADS=12
BEAM_SIZE=5
